<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="100dp" />
            <gradient android:angle="270" android:startColor="#A9B4CF" android:endColor="#E6EAF3" />
            <stroke android:width="1dp" android:color="#6D7385" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="100dp" />
            <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#C3C9D8" />
            <stroke android:width="1dp" android:color="#6D7385" />
        </shape>
    </item>
</selector>
