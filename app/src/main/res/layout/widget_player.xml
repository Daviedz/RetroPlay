<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget. Bitmaps (LCD, sliders) are drawn by WidgetRenderer;
     the transparent "zone" cells over each slider make it tappable. -->
<!-- The window keeps its natural height (set by the LCD bitmap) and sits centred
     in the widget area; any spare space stays transparent. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_outer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:background="@drawable/widget_face_classic"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- title bar -->
    <LinearLayout
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:background="@drawable/widget_title_classic"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <TextView
            android:id="@+id/w_menu"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="≡"
            android:textSize="15sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="#E4DDBA" />
        <ImageView
            android:id="@+id/w_stripe1"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_stripes_classic" />
        <TextView
            android:id="@+id/w_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="RETROPLAY"
            android:letterSpacing="0.2"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#E4DDBA" />
        <ImageView
            android:id="@+id/w_stripe2"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_stripes_classic" />
        <FrameLayout android:layout_width="22dp" android:layout_height="match_parent" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="5dp" />

    <!-- LCD row: its height comes from the LCD bitmap (Small / Medium / Large) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.42">
            <ImageView
                android:id="@+id/w_lcd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_lcd_classic"
                android:scaleType="fitXY" />
            <!-- The clock is real text (launchers refresh text reliably; the LCD picture can stall) -->
            <TextView
                android:id="@+id/w_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textStyle="bold"
                android:typeface="monospace"
                android:textColor="#00E800"
                android:textSize="17dp" />
        </FrameLayout>
        <FrameLayout android:layout_width="6dp" android:layout_height="match_parent" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.58"
            android:orientation="vertical">
            <FrameLayout
                android:id="@+id/w_marquee_box"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:background="@drawable/widget_lcd_classic"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <!-- Track title: split into pieces that slide through one after another.
                     The launcher runs the animation itself, so it costs no updates. -->
                <ViewFlipper
                    android:id="@+id/w_title_flip"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autoStart="true"
                    android:flipInterval="2500"
                    android:inAnimation="@anim/widget_title_in"
                    android:outAnimation="@anim/widget_title_out" />
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="3dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/w_kbps"
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_lcd_classic"
                    android:gravity="end|center_vertical"
                    android:paddingEnd="3dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#00E800" />
                <TextView
                android:id="@+id/w_kbps_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kbps"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#C8C8DC" android:paddingStart="3dp" android:paddingEnd="5dp" />
                <TextView
                    android:id="@+id/w_khz"
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_lcd_classic"
                    android:gravity="end|center_vertical"
                    android:paddingEnd="3dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#00E800" />
                <TextView
                android:id="@+id/w_khz_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kHz"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#C8C8DC" android:paddingStart="3dp" />
                <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <TextView
                android:id="@+id/w_stereo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="stereo"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#C8C8DC"
                android:textSize="8sp" />
            </LinearLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="3dp" />
            <LinearLayout
                android:id="@+id/w_toggles"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/w_eq"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                
                android:background="@drawable/widget_btn_classic">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/w_eq_led"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/widget_led_square" />
                    <TextView
                        android:id="@+id/w_eq_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EQ"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#1C1C30" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/w_pl"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_btn_classic">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/w_pl_led"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/widget_led_square" />
                    <TextView
                        android:id="@+id/w_pl_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PL"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#1C1C30" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/w_art"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_btn_classic">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/w_art_led"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/widget_led_square" />
                    <TextView
                        android:id="@+id/w_art_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ART"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#1C1C30" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/w_ml"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_btn_classic">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/w_ml_led"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/widget_led_square" />
                    <TextView
                        android:id="@+id/w_ml_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ML"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#1C1C30" />
                </LinearLayout>
            </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="5dp" />

    <!-- VOL / BAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
                android:id="@+id/w_vol_l"
                android:layout_width="26dp"
                android:layout_height="wrap_content"
                android:text="VOL"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#C8C8DC" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.62">
            <ImageView
                android:id="@+id/w_vol"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <FrameLayout android:id="@+id/w_vol_z0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_vol_z1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_vol_z2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_vol_z3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_vol_z4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_vol_z5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_vol_z6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_vol_z7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_vol_z8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_vol_z9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_vol_z10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="10dp" android:layout_height="match_parent" />
        <TextView
                android:id="@+id/w_bal_l"
                android:layout_width="26dp"
                android:layout_height="wrap_content"
                android:text="BAL"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#C8C8DC" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.38">
            <ImageView
                android:id="@+id/w_bal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <FrameLayout android:id="@+id/w_bal_z0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_bal_z1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_bal_z2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_bal_z3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_bal_z4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="5dp" />

    <!-- seek bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="14dp">
        <ImageView
            android:id="@+id/w_seek"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
                <FrameLayout android:id="@+id/w_seek_z0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <FrameLayout android:id="@+id/w_seek_z19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="5dp" />

    <!-- transport -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/w_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                
                android:background="@drawable/widget_btn_classic">
                <ImageView
                    android:id="@+id/w_prev_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_prev" />
                <ImageView
                    android:id="@+id/w_prev_led"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="3dp"
                    android:src="@drawable/widget_led_square"
                    android:visibility="gone" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/w_play"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_btn_classic">
                <ImageView
                    android:id="@+id/w_play_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play" />
                <ImageView
                    android:id="@+id/w_play_led"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="3dp"
                    android:src="@drawable/widget_led_square"
                    android:visibility="gone" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/w_pause"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_btn_classic">
                <ImageView
                    android:id="@+id/w_pause_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_pause" />
                <ImageView
                    android:id="@+id/w_pause_led"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="3dp"
                    android:src="@drawable/widget_led_square"
                    android:visibility="gone" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/w_stop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_btn_classic">
                <ImageView
                    android:id="@+id/w_stop_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_stop" />
                <ImageView
                    android:id="@+id/w_stop_led"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="3dp"
                    android:src="@drawable/widget_led_square"
                    android:visibility="gone" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/w_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_btn_classic">
                <ImageView
                    android:id="@+id/w_next_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_next" />
                <ImageView
                    android:id="@+id/w_next_led"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="3dp"
                    android:src="@drawable/widget_led_square"
                    android:visibility="gone" />
            </FrameLayout>
            <FrameLayout android:layout_width="3dp" android:layout_height="match_parent" />
            <FrameLayout
                android:id="@+id/w_eject"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_btn_classic">
                <ImageView
                    android:id="@+id/w_eject_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_eject" />
                <ImageView
                    android:id="@+id/w_eject_led"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="3dp"
                    android:src="@drawable/widget_led_square"
                    android:visibility="gone" />
            </FrameLayout>
            <FrameLayout android:layout_width="3dp" android:layout_height="match_parent" />
            <FrameLayout
                android:id="@+id/w_shuf"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_btn_classic">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/w_shuf_led"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/widget_led_square" />
                    <TextView
                        android:id="@+id/w_shuf_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SHUF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#1C1C30" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/w_rep"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:layout_marginStart="3dp"
                android:background="@drawable/widget_btn_classic">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/w_rep_led"
                        android:layout_width="5dp"
                        android:layout_height="5dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/widget_led_square" />
                    <ImageView
                        android:id="@+id/w_rep_icon"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_repeat" />
                </LinearLayout>
            </FrameLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
